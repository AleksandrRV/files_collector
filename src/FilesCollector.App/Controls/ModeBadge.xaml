<UserControl x:Class="FilesCollector.App.Controls.ModeBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <Border x:Name="Badge"
          CornerRadius="999"
          Padding="7,2"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0">
    <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0" />
      <TextBlock x:Name="Label"
                 FontSize="11"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
