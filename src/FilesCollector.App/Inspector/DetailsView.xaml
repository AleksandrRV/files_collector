<UserControl x:Class="FilesCollector.App.Inspector.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FilesCollector.App.Controls"
             Focusable="False">
  <Grid>
    <StackPanel>
      <StackPanel Margin="0,0,0,4" Visibility="{Binding NodeName, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="18"
                     Margin="0,0,8,0"
                     VerticalAlignment="Top"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding NodeIconGlyph}" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding NodeName}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding NodeName}" />
            <TextBlock Text="{Binding NodeRelativePath}"
                       Style="{StaticResource MonoText}"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <controls:SegmentedModeControl x:Name="ModeControl" Margin="0,10" />

        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     FontFamily="Cascadia Code, Consolas"
                     FontSize="11"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"
                     Text="{Binding SourceGlyph}"
                     Foreground="{Binding SourceGlyph, Converter={StaticResource SourceGlyphToBrushConverter}}" />
          <TextBlock Grid.Column="1"
                     FontSize="12"
                     VerticalAlignment="Center"
                     Text="{Binding SourceDescription}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </Grid>

        <Border Margin="0,4,0,0"
                Padding="8,6"
                CornerRadius="6"
                Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1"
                Visibility="{Binding ReasonText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
          <TextBlock Text="{Binding ReasonText}" FontSize="12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <StackPanel Visibility="{Binding NodeName, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
        <TextBlock Style="{StaticResource DetailLabelText}" Text="SIZE" />
        <TextBlock Style="{StaticResource DetailValueText}" Text="{Binding NodeSizeText}" />

        <TextBlock Style="{StaticResource DetailLabelText}" Text="ATTRIBUTES" Visibility="{Binding NodeAttributes, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
        <TextBlock Style="{StaticResource DetailValueText}" Text="{Binding NodeAttributes}" Visibility="{Binding NodeAttributes, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />

        <TextBlock Style="{StaticResource DetailLabelText}" Text="AVAILABILITY" Visibility="{Binding NodeAvailability, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
        <TextBlock Style="{StaticResource DetailValueText}" Text="{Binding NodeAvailability}" Foreground="{DynamicResource ErrorBrush}" Visibility="{Binding NodeAvailability, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
      </StackPanel>

      <StackPanel Margin="0,10,0,0" Visibility="{Binding NodeName, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
        <TextBlock Style="{StaticResource SectionTitleText}" Text="RULE RESOLUTION" />
        <ItemsControl ItemsSource="{Binding RuleSteps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}"
                        Visibility="{Binding IsWinner, Converter={StaticResource BoolToVisibilityConverter}}">
                  <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="10"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Text="&#xE73E;"
                             Foreground="{DynamicResource TextInverseBrush}" />
                </Border>
                <Border Grid.Column="0"
                        Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsWinner, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource BorderStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding Detail, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="11"
                           Text="{Binding ModeText}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding NodeName, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
        <Button Content="Reset rule" Command="{Binding ResetLocalRuleCommand}" IsEnabled="{Binding HasLocalRule}" />
        <Button Content="Explorer" Command="{Binding RevealInExplorerCommand}" Margin="6,0,0,0" ToolTip="Reveal in Explorer" />
        <Button Content="Open" Command="{Binding OpenFileCommand}" Margin="6,0,0,0" />
        <Button Content="Copy path" Command="{Binding CopyPathCommand}" Margin="6,0,0,0" ToolTip="Copy full path" />
        <Button Content="Copy rel." Command="{Binding CopyRelativePathCommand}" Margin="6,0,0,0" ToolTip="Copy relative path" />
      </StackPanel>

      <TextBlock Margin="0,0,0,0"
                 Style="{StaticResource CaptionText}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Text="Select a file or folder in the tree to see details."
                 Visibility="{Binding NodeName, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}, ConverterParameter=invert}" />
    </StackPanel>
  </Grid>
</UserControl>
