<UserControl x:Class="FilesCollector.App.Inspector.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FilesCollector.App.Controls"
             Focusable="False">
  <UserControl.Resources>
    <local:ShareToStarConverter x:Key="ShareToStarConverter" xmlns:local="clr-namespace:FilesCollector.App" />
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Style="{StaticResource SectionTitleText}" Text="REPORT PLAN" />

      <TextBlock Style="{StaticResource CaptionText}"
                 Margin="0,0,0,8"
                 Text="The plan is not available until the inventory is loaded."
                 Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCard}">
          <StackPanel>
            <controls:ModeBadge Mode="Full" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding FullCount}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding FullSizeText}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,0,8">
          <StackPanel>
            <controls:ModeBadge Mode="Signatures" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SignaturesCount}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding SignaturesSizeText}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
          <StackPanel>
            <controls:ModeBadge Mode="Listed" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ListedCount}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding ListedSizeText}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource StatCard}" Margin="0">
          <StackPanel>
            <controls:ModeBadge Mode="Excluded" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ExcludedCount}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding ExcludedSizeText}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Height="8" Margin="0,4,0,10" ClipToBounds="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FullShare, Converter={StaticResource ShareToStarConverter}}" />
            <ColumnDefinition Width="{Binding SignaturesShare, Converter={StaticResource ShareToStarConverter}}" />
            <ColumnDefinition Width="{Binding ListedShare, Converter={StaticResource ShareToStarConverter}}" />
            <ColumnDefinition Width="{Binding ExcludedShare, Converter={StaticResource ShareToStarConverter}}" />
          </Grid.ColumnDefinitions>
          <Rectangle Grid.Column="0" Fill="{DynamicResource ModeFullBrush}" />
          <Rectangle Grid.Column="1" Fill="{DynamicResource ModeSignaturesBrush}" />
          <Rectangle Grid.Column="2" Fill="{DynamicResource ModeListedBrush}" />
          <Rectangle Grid.Column="3" Fill="{DynamicResource ModeExcludedBrush}" Opacity="0.55" />
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding EstimatedBytesText}" />
        <TextBlock FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TokensText}" />
        <TextBlock FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding ContextNote}" />
      </StackPanel>

      <Border Margin="0,0,0,10"
              Padding="10,8"
              CornerRadius="6"
              Background="{DynamicResource WarningSoftBrush}"
              BorderBrush="{DynamicResource WarningBrush}"
              BorderThickness="1"
              Visibility="{Binding IsLargeWarning, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" />
          <TextBlock FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="Large report warning: the estimated size exceeds 25 MB. Consider excluding more files or lowering the maximum file size." Foreground="{DynamicResource WarningBrush}" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitleText}" Text="TOP EXCLUSION REASONS" Visibility="{Binding HasReasons, Converter={StaticResource BoolToVisibilityConverter}}" />
      <ItemsControl ItemsSource="{Binding TopReasons}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Count}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource SectionTitleText}" Text="TOP EXTENSIONS" Visibility="{Binding HasExtensions, Converter={StaticResource BoolToVisibilityConverter}}" />
      <ItemsControl ItemsSource="{Binding TopExtensions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Extension}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Count, StringFormat={}{0:N0}}" />
              <Rectangle Grid.Column="2" Height="4" RadiusX="2" RadiusY="2" Margin="8,0" VerticalAlignment="Center" Fill="{DynamicResource AccentSoftBrush}"
                         Width="{Binding SizeShare, Converter={StaticResource ShareToWidthConverter}, ConverterParameter=60}" />
              <TextBlock Grid.Column="3" FontFamily="Cascadia Code, Consolas" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding SizeBytes, Converter={StaticResource LongToSizeConverter}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource SectionTitleText}" Text="PROBLEM FILES" Visibility="{Binding HasProblemFiles, Converter={StaticResource BoolToVisibilityConverter}}" />
      <ItemsControl ItemsSource="{Binding ProblemFiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource WarningBrush}" Text="{Binding ReasonText}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="1" Content="Show" Padding="8,2" FontSize="11" VerticalAlignment="Center" Command="{Binding DataContext.RevealInTreeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding RelativePath}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Style="{StaticResource SectionTitleText}" Text="DIAGNOSTICS — LAST GENERATION" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding LastGenerationLabel}" />
        <ItemsControl ItemsSource="{Binding DiagnosticsGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Count}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Items}" MaxHeight="66">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
