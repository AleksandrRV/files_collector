<UserControl x:Class="FilesCollector.App.Inspector.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <WrapPanel>
        <CheckBox Content="Show excluded" IsChecked="{Binding PreviewShowExcluded, Mode=TwoWay}" Margin="0,0,10,4" />
        <CheckBox Content="Show reasons" IsChecked="{Binding PreviewShowReasons, Mode=TwoWay}" Margin="0,0,10,4" />
        <CheckBox Content="YAML metadata" IsChecked="{Binding PreviewShowYaml, Mode=TwoWay}" Margin="0,0,10,4" />
        <Button Content="Refresh" Command="{Binding RefreshPreviewCommand}" Padding="10,3" FontSize="12" Margin="0,0,10,4" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Style="{StaticResource HintText}" Text="First 50 items of the current plan, as they will appear in the Markdown report." />
    </StackPanel>

    <Border Grid.Row="1"
            Style="{StaticResource Card}"
            Padding="10"
            BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding PreviewLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontFamily="Cascadia Code, Consolas" FontSize="11.5" Margin="0,1" Text="{Binding Text}" TextWrapping="NoWrap" LineHeight="16">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="Header">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="Meta">
                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="Note">
                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                        <Setter Property="FontStyle" Value="Italic" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="Item">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                      </DataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Kind}" Value="Item" />
                          <Condition Binding="{Binding Mode}" Value="Full" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ModeFullBrush}" />
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Kind}" Value="Item" />
                          <Condition Binding="{Binding Mode}" Value="Signatures" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ModeSignaturesBrush}" />
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Kind}" Value="Item" />
                          <Condition Binding="{Binding Mode}" Value="Listed" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ModeListedBrush}" />
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Kind}" Value="Item" />
                          <Condition Binding="{Binding Mode}" Value="Excluded" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ModeExcludedBrush}" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
