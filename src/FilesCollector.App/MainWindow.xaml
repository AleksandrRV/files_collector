<Window x:Class="FilesCollector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FilesCollector.App"
        Title="Files Collector"
        Width="1080"
        Height="700"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <HierarchicalDataTemplate DataType="{x:Type local:FileTreeNode}" ItemsSource="{Binding Children}">
      <Grid x:Name="NodeRow" ToolTip="{Binding ToolTipText}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="58" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="105" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="112" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding IconText}" />
        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding EffectiveModeText}" />
        <TextBlock Grid.Column="3" Text="{Binding RuleSourceText}" />
        <TextBlock Grid.Column="4" Foreground="Gray" Text="{Binding StatusText}" />
      </Grid>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
          <Setter TargetName="NodeRow" Property="Opacity" Value="0.55" />
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SavePresetCommand}" />
    <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
  </Window.InputBindings>

  <DockPanel LastChildFill="True" Margin="16">
    <StatusBar DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock Text="{Binding StatusText}" />
    </StatusBar>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Files Collector" />
        <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray" Text="Step 7: report generation" />
        <Button Grid.Column="2" Margin="0,0,8,0" MinWidth="130" Padding="12,5" Command="{Binding GenerateReportCommand}" Content="Create report" />
        <Button Grid.Column="3" MinWidth="110" Padding="12,5" Command="{Binding ShowAboutCommand}" Content="About" />
      </Grid>

      <Border Grid.Row="1" Margin="0,18,0,12" Padding="12" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Scan root:" />
          <TextBox Grid.Column="1" Margin="12,0" IsReadOnly="True" Text="{Binding ScanRoot}" />
          <Button Grid.Column="2" Margin="0,0,8,0" Padding="12,5" Command="{Binding RequestRootChangeCommand}" Content="Change..." />
          <Button Grid.Column="3" Margin="0,0,8,0" Padding="12,5" Command="{Binding ReloadCommand}" Content="Refresh tree" />
          <Button Grid.Column="4" Padding="12,5" Command="{Binding RefreshInventoryCommand}" Content="Refresh inventory" />
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TabControl Grid.Column="0">
          <TabItem Header="Preset">
            <StackPanel Margin="10">
              <ComboBox DisplayMemberPath="Name"
                        ItemsSource="{Binding PresetItems}"
                        SelectedValue="{Binding SelectedPresetId}"
                        SelectedValuePath="Id" />
              <TextBlock Margin="0,8,0,0" Foreground="DarkOrange" Text="Unsaved changes" Visibility="{Binding IsPresetDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <WrapPanel Margin="0,10,0,0">
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding NewPresetCommand}" Content="New" />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding SavePresetCommand}" Content="Save" />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding SavePresetAsCommand}" Content="Save as..." />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding RenamePresetCommand}" Content="Rename" />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding DeletePresetCommand}" Content="Delete" />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding DiscardPresetChangesCommand}" Content="Discard" />
              </WrapPanel>
            </StackPanel>
          </TabItem>
          <TabItem Header="Search">
            <StackPanel Margin="10">
              <TextBlock Text="Search tree:" />
              <TextBox Margin="0,4,0,10" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
              <CheckBox Content="Show files" IsChecked="{Binding ShowFiles}" />
              <CheckBox Margin="0,6,0,0" Content="Show folders" IsChecked="{Binding ShowFolders}" />
              <CheckBox Margin="0,6,0,0" Content="Local rules only" IsChecked="{Binding ShowLocalRulesOnly}" />
              <CheckBox Margin="0,6,0,0" Content="Excluded only" IsChecked="{Binding ShowExcludedOnly}" />
              <TextBlock Margin="0,16,0,4" Text="Selected item:" />
              <TextBox IsReadOnly="True" AcceptsReturn="True" Height="110" Text="{Binding SelectedNodeDetails}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
          </TabItem>
          <TabItem Header="Formats">
            <DockPanel Margin="8">
              <CheckBox DockPanel.Dock="Top" Margin="0,0,0,8" Content="Include all extensions" IsChecked="{Binding IncludeAllExtensions}" />
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding ExtensionRuleItems}">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Binding="{Binding Enabled, Mode=TwoWay}" Header="Use" />
                  <DataGridTextColumn Binding="{Binding Extension}" Header="Extension" IsReadOnly="True" />
                  <DataGridTextColumn Binding="{Binding Count}" Header="Files" IsReadOnly="True" />
                  <DataGridTemplateColumn Header="Mode">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding DataContext.CollectionModes, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Mode, Mode=TwoWay}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="Filters">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="10">
                <CheckBox Content="Include hidden files" IsChecked="{Binding IncludeHidden}" />
                <CheckBox Margin="0,6,0,0" Content="Include system files" IsChecked="{Binding IncludeSystem}" />
                <CheckBox Margin="0,6,0,0" Content="Follow reparse points" IsChecked="{Binding FollowReparsePoints}" />
                <CheckBox Margin="0,6,0,0" Content="Redact root path in output" IsChecked="{Binding RedactRootPath}" />
                <CheckBox Margin="0,6,0,0" Content="Include per-file YAML metadata blocks" IsChecked="{Binding IncludeFileMetadataBlocks}" />
                <TextBlock Margin="0,12,0,2" Text="Inventory refresh interval, minutes (0 disables):" />
                <TextBox Text="{Binding InventoryRefreshMinutes, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,4,0,2" Foreground="Gray" Text="{Binding InventoryStatus}" TextWrapping="Wrap" />
                <Button Margin="0,4,0,0" Command="{Binding RefreshInventoryCommand}" Content="Refresh inventory now" />
                <TextBlock Margin="0,12,0,2" Text="Maximum file size, KiB:" />
                <TextBox Text="{Binding MaxFileSizeKiB, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,12,0,2" Text="Binary file mode:" />
                <ComboBox ItemsSource="{Binding CollectionModes}" SelectedItem="{Binding BinaryFileMode}" />
                <TextBlock Margin="0,12,0,2" Text="Include patterns, one per line:" />
                <TextBox AcceptsReturn="True" Height="80" Text="{Binding IncludePatternsText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Margin="0,12,0,2" Text="Exclude patterns, one per line:" />
                <TextBox AcceptsReturn="True" Height="80" Text="{Binding ExcludePatternsText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <Button Margin="0,12,0,0" Command="{Binding RefreshPlanCommand}" Content="Refresh plan" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Prefix">
            <StackPanel Margin="10">
              <ComboBox DisplayMemberPath="Name"
                        ItemsSource="{Binding PrefixPresets.Items}"
                        SelectedValue="{Binding PrefixPresets.SelectedId}"
                        SelectedValuePath="Id" />
              <TextBlock Margin="0,8,0,0" Foreground="DarkOrange" Text="Unsaved changes" Visibility="{Binding PrefixPresets.IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <TextBox Margin="0,8,0,0" AcceptsReturn="True" Height="160" IsEnabled="{Binding PrefixPresets.HasSelection}" Text="{Binding PrefixPresets.Content, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
              <WrapPanel Margin="0,10,0,0">
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding PrefixPresets.ClearSelectionCommand}" Content="No prefix" />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding PrefixPresets.NewCommand}" Content="New" />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding PrefixPresets.SaveCommand}" Content="Save" />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding PrefixPresets.SaveAsCommand}" Content="Save as..." />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding PrefixPresets.RenameCommand}" Content="Rename" />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding PrefixPresets.DeleteCommand}" Content="Delete" />
                <Button Margin="0,0,8,8" Padding="10,4" Command="{Binding PrefixPresets.DiscardCommand}" Content="Discard" />
              </WrapPanel>
            </StackPanel>
          </TabItem>
        </TabControl>

        <TabControl Grid.Column="2">
          <TabItem Header="File tree">
            <TreeView ItemsSource="{Binding RootNodes}"
                      SelectedItemChanged="OnSelectedItemChanged"
                      TreeViewItem.Expanded="OnTreeViewItemExpanded"
                      PreviewMouseRightButtonDown="OnTreeViewPreviewMouseRightButtonDown">
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Full" Tag="Full" Click="OnApplyModeMenuItemClick" />
                  <MenuItem Header="Signatures" Tag="Signatures" Click="OnApplyModeMenuItemClick" />
                  <MenuItem Header="Listed" Tag="Listed" Click="OnApplyModeMenuItemClick" />
                  <MenuItem Header="Excluded" Tag="Excluded" Click="OnApplyModeMenuItemClick" />
                  <Separator />
                  <MenuItem Header="Reset local rule" Click="OnResetLocalRuleMenuItemClick" />
                </ContextMenu>
              </TreeView.ContextMenu>
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="False" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TreeView.ItemContainerStyle>
            </TreeView>
          </TabItem>
          <TabItem Header="Preview">
            <DockPanel Margin="8">
              <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding RefreshPreviewCommand}" Content="Refresh preview" />
              <TextBox IsReadOnly="True" AcceptsReturn="True" Text="{Binding PreviewText}" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>

      <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Collection mode:" />
          <ComboBox Grid.Column="1" Margin="12,0" ItemsSource="{Binding CollectionModes}" SelectedItem="{Binding SelectedMode}" />
          <Button Grid.Column="2" Padding="12,5" Command="{Binding ApplySelectedModeCommand}" Content="Apply" />
          <Button Grid.Column="3" Margin="8,0,0,0" Padding="12,5" Command="{Binding ResetLocalRuleCommand}" Content="Reset local rule" />
          <StackPanel Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="Gray" Text="Folder rules apply recursively. Rules: " />
              <TextBlock Foreground="Gray" Text="{Binding RuleCount}" />
            </StackPanel>
            <TextBlock Foreground="Gray" Text="{Binding PlanSummary}" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="Gray" Text="{Binding GenerationStatus}" TextTrimming="CharacterEllipsis" />
              <Button Margin="12,0,0,0" Padding="8,2" Command="{Binding GenerateReportCancelCommand}" Content="Cancel" />
              <Button Margin="8,0,0,0" Padding="8,2" Command="{Binding OpenOutputCommand}" Content="Open report" />
              <Button Margin="8,0,0,0" Padding="8,2" Command="{Binding OpenOutputsCommand}" Content="Open outputs" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
