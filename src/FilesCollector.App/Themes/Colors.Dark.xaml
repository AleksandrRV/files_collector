<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E2E" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#28283C" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#34344A" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8E8F0" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9C9CB4" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#62627A" />

    <SolidColorBrush x:Key="AccentBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#29818CF8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#12121A" />

    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#24F87171" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />

    <!-- Collection mode semantics (shared across tree, formats, plan bar) -->
    <SolidColorBrush x:Key="ModeFullBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="ModeSignaturesBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="ModeListedBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ModeExcludedBrush" Color="#8B8B9E" />

</ResourceDictionary>
