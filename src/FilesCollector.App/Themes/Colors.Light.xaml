<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E2E6EC" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1F24" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6572" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9AA1AC" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A4F46E5" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1ADC2626" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />

    <!-- Collection mode semantics (shared across tree, formats, plan bar) -->
    <SolidColorBrush x:Key="ModeFullBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="ModeSignaturesBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ModeListedBrush" Color="#D97706" />
    <SolidColorBrush x:Key="ModeExcludedBrush" Color="#9CA3AF" />

</ResourceDictionary>
