<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Light theme palette ===== -->

  <Color x:Key="WindowBackgroundColor">#F5F6F8</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceAltColor">#EEF0F4</Color>
  <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
  <Color x:Key="BorderColor">#E3E6EB</Color>
  <Color x:Key="BorderStrongColor">#C9CEDA</Color>

  <Color x:Key="TextPrimaryColor">#1B1F27</Color>
  <Color x:Key="TextSecondaryColor">#5A6270</Color>
  <Color x:Key="TextTertiaryColor">#8A93A3</Color>
  <Color x:Key="TextInverseColor">#FFFFFF</Color>

  <Color x:Key="AccentColor">#4F46E5</Color>
  <Color x:Key="AccentHoverColor">#4338CA</Color>
  <Color x:Key="AccentPressedColor">#3730A3</Color>
  <Color x:Key="AccentSoftColor">#EEF0FE</Color>
  <Color x:Key="AccentSoftTextColor">#3F3ACF</Color>

  <Color x:Key="SelectionColor">#E4E9FD</Color>
  <Color x:Key="HoverColor">#F0F2F6</Color>

  <Color x:Key="ModeFullColor">#1A7F37</Color>
  <Color x:Key="ModeFullSoftColor">#E4F5E9</Color>
  <Color x:Key="ModeSignaturesColor">#0B5CAD</Color>
  <Color x:Key="ModeSignaturesSoftColor">#E5F0FB</Color>
  <Color x:Key="ModeListedColor">#9A5B00</Color>
  <Color x:Key="ModeListedSoftColor">#FDF1DE</Color>
  <Color x:Key="ModeExcludedColor">#6B7280</Color>
  <Color x:Key="ModeExcludedSoftColor">#ECEEF1</Color>

  <Color x:Key="WarningColor">#B45309</Color>
  <Color x:Key="WarningSoftColor">#FDF1DE</Color>
  <Color x:Key="ErrorColor">#C22B2B</Color>
  <Color x:Key="ErrorSoftColor">#FCE8E8</Color>
  <Color x:Key="SuccessColor">#1A7F37</Color>
  <Color x:Key="SuccessSoftColor">#E4F5E9</Color>

  <Color x:Key="SourceLocalColor">#4F46E5</Color>
  <Color x:Key="SourceInheritedColor">#5A6270</Color>
  <Color x:Key="SourceExtensionColor">#8A93A3</Color>
  <Color x:Key="SourceMutedColor">#B6BDCB</Color>

  <Color x:Key="ShadowColor">#1B1F27</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}" />
  <SolidColorBrush x:Key="TextInverseBrush" Color="{DynamicResource TextInverseColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentSoftTextBrush" Color="{DynamicResource AccentSoftTextColor}" />

  <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />

  <SolidColorBrush x:Key="ModeFullBrush" Color="{DynamicResource ModeFullColor}" />
  <SolidColorBrush x:Key="ModeFullSoftBrush" Color="{DynamicResource ModeFullSoftColor}" />
  <SolidColorBrush x:Key="ModeSignaturesBrush" Color="{DynamicResource ModeSignaturesColor}" />
  <SolidColorBrush x:Key="ModeSignaturesSoftBrush" Color="{DynamicResource ModeSignaturesSoftColor}" />
  <SolidColorBrush x:Key="ModeListedBrush" Color="{DynamicResource ModeListedColor}" />
  <SolidColorBrush x:Key="ModeListedSoftBrush" Color="{DynamicResource ModeListedSoftColor}" />
  <SolidColorBrush x:Key="ModeExcludedBrush" Color="{DynamicResource ModeExcludedColor}" />
  <SolidColorBrush x:Key="ModeExcludedSoftBrush" Color="{DynamicResource ModeExcludedSoftColor}" />

  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{DynamicResource WarningSoftColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
  <SolidColorBrush x:Key="ErrorSoftBrush" Color="{DynamicResource ErrorSoftColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="{DynamicResource SuccessSoftColor}" />

  <SolidColorBrush x:Key="SourceLocalBrush" Color="{DynamicResource SourceLocalColor}" />
  <SolidColorBrush x:Key="SourceInheritedBrush" Color="{DynamicResource SourceInheritedColor}" />
  <SolidColorBrush x:Key="SourceExtensionBrush" Color="{DynamicResource SourceExtensionColor}" />
  <SolidColorBrush x:Key="SourceMutedBrush" Color="{DynamicResource SourceMutedColor}" />

  <SolidColorBrush x:Key="ShadowBrush" Color="{DynamicResource ShadowColor}" Opacity="0.16" />
  <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource ShadowColor}" Opacity="0.32" />

</ResourceDictionary>
